# AH53 2D X-Y fixed-period translation test. Existing FSP required.
# EDIT ridge object names to match your FSP BEFORE running.
# R must be a Y-normal reflected-field monitor ABOVE the source,
# and the reflected region must be uniform Air.
# Exports flux-normalized COMPLEX gratingvector components: not yet r_ss/r_pp.
# Run once for s source (component=3, Ez), then for p (component=1, Ex proxy).
# No use of source-side power when monitor contains incident field.
P=16e-6;
lam_nm=643;
mon="R";
component=3;
phase_sign=-1; # If gratingvector convention is reversed, change to +1 after checking.
ridges={"grating_ridge_1","grating_ridge_2","grating_ridge_3"};
d_nm=[0,5,10,15,20,25,30,50,75,100];
orders=[-5,-1,0,1,5];
valid=1;
for (k=1:length(ridges)) {
  if (getnamednumber(ridges{k})!=1) {
    ?"ERROR: missing or duplicated ridge: "+ridges{k};
    valid=0;
  }
}
if (getnamednumber(mon)!=1) {
  ?"ERROR: reflected monitor not found.";
  valid=0;
}
if (valid==1) {
  switchtolayout;
  x_orig=matrix(length(ridges));
  for (k=1:length(ridges)) {
    x_orig(k)=getnamed(ridges{k},"x");
  }
  a=matrix(length(d_nm),length(orders));
  eta=matrix(length(d_nm),length(orders));
  D=matrix(length(d_nm),length(orders));
  Rtotal=matrix(length(d_nm));

  for (j=1:length(d_nm)) {
    switchtolayout;
    d=d_nm(j)*1e-9;
    for (k=1:length(ridges)) {
      setnamed(ridges{k},"x",x_orig(k)+d);
    }
    run;
    f=getdata(mon,"f");
    fi=find(c/f*1e9,lam_nm);
    N=gratingn(mon,fi);
    V=pinch(gratingvector(mon,fi,1,1));
    T=transmission(mon);
    Rtotal(j)=abs(T(fi));

    for (k=1:length(orders)) {
      mm=orders(k);
      ind=find(N,mm);
      # Flux-normalized complex component, valid for a nonzero reflecting field.
      a(j,k)=sqrt(Rtotal(j))*V(ind,component);
    }
    ?"completed displacement d(nm)="+num2str(d_nm(j));
    # Keep source, monitor and reference plane positions FIXED.
  }
  for (k=1:length(orders)) {
    mm=orders(k);
    a0=a(1,k);
    for (j=1:length(d_nm)) {
      ideal=a0*exp(1i*phase_sign*2*pi*mm*d_nm(j)*1e-9/P);
      D(j,k)=a(j,k)-ideal;
      if (abs(a0)>1e-12) {
        eta(j,k)=abs(a(j,k)-ideal)/abs(a0);
      } else {
        eta(j,k)=0; # phase/relative errors undefined at a very weak order
      }
    }
  }
  plot(d_nm,abs(a(:,2)),abs(a(:,4)),abs(a(:,5)),
    "d (nm)","|flux-normalized component|","AH53 translation: -1,+1,+5");
  legend("m=-1","m=+1","m=+5");
  plot(d_nm,abs(D(:,2)),abs(D(:,4)),abs(D(:,5)),
    "d (nm)","|D_m|","AH53 complex translation residual");
  legend("m=-1","m=+1","m=+5");
  plot(d_nm,Rtotal,"d (nm)","Reflected power / source power","R total");
  savedata("AH53_translation_sweep",d_nm,orders,a,D,eta,Rtotal,P,lam_nm,component,phase_sign);
  ?"Saved AH53_translation_sweep.ldf";
}
# CAUTION:
# - gratingvector gives a power-normalized far-field vector in a particular
#   projection basis, not an E-field Jones reflection coefficient.
# - The scaling sqrt(Rtotal) is adequate for comparative translation tests
#   with fixed polarization, monitor, projection convention, and incidence.
# - For p incidence, Ex alone is a projection, not the complete p-amplitude.
# - If structures are generated by a setup script, move the INPUT parameter
#   instead of moving already generated child objects before run.
