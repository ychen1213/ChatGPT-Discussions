# AH53: remove ONLY 7.9 nm film to isolate its influence.
# WORK ONLY ON A COPY of your real FSP model.
# Material distribution changes: optical r_m values between the two models
# need not match. Compare translation-invariance error, not raw amplitude.
switchtolayout;
nm="film_7p9nm"; # EDIT to actual CAD object name
if (getnamednumber(nm)==1) {
  ?"Removing layer "+nm+" in this COPY of the project.";
  select(nm);
  delete;
  save("AH53_without_7p9nm_film.fsp");
} else {
  ?"ERROR: 7.9 nm layer object missing or duplicate; nothing removed.";
}
# After creating both original and control models, run the SAME
# shift-sweep script and compare residual |D_m|/|a_m(0)|.
# If the layer is generated by a structure-group setup script,
# also change its generating input; otherwise it may reappear.
